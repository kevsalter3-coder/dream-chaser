<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Camera usage — required before any AVCaptureSession is created -->
    <key>NSCameraUsageDescription</key>
    <string>ReUp365 uses the camera to scan grocery barcodes and photograph receipts so you can track your pantry automatically.</string>

    <!-- Push notifications (local) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>

    <!-- Instacart deep-link scheme in LSApplicationQueriesSchemes so canOpenURL works -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>instacart</string>
    </array>

    <!-- Minimum iOS version -->
    <key>MinimumOSVersion</key>
    <string>17.0</string>

    <!-- App Transport Security: allow Open Food Facts over HTTPS -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <key>CFBundleDisplayName</key>
    <string>ReUp365</string>
    <key>CFBundleIdentifier</key>
    <string>com.reup365.app</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
